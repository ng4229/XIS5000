void CViewerDlg::OnDatetimechangeDatetimepicker(NMHDR *pNMHDR, LRESULT *pResult)
{
	LPNMDATETIMECHANGE pDTChange = reinterpret_cast<LPNMDATETIMECHANGE>(pNMHDR);
	// TODO: 여기에 컨트롤 알림 처리기 코드를 추가합니다.
	CString temp=m_CurrentDate;
	UpdateData(true);
    m_CurrentDate.Format(_T("%4d-%02d-%02d"), m_Date.GetYear(), m_Date.GetMonth(), m_Date.GetDay());  
	if(m_CurrentDate!=temp)
	{
		*pResult = 0;
		m_ZoomRate=10;
		SearchListData();
	}
	*pResult = 0;
}

bool CViewerDlg::GetXY()
{
	if(!b_IsMakeArray)
		return false;

	for(int i=0;i<g_Height;i++)
	{
		for(int j=0;j<g_Width;j++)
		{
			m_BadImg[i][j]=0;
		}
	}

	CFile file;
	CString TempPass, m_Data, tempbad, tempx, tempy;
	TempPass.Format(_T("%s\\Log\\%s"), m_StrDirectory, m_StrLogName);
	char szDelimiter[2];
	char *szToken;
	int nPos=0;
	
	if(file.Open(TempPass,CFile::modeRead))
	{
		szToken = new char[file.GetLength()];
		if(file.Read(szDelimiter,1))
		{
			while((*szDelimiter) != '@')
			{
				if((*szDelimiter) == '#')
				{
					m_ProductName="";
					GetDlgItem(IDC_PRODUCTNAME)->SetWindowText(m_ProductName);
					file.SeekToBegin();
					goto STEP1;
				}
				(szToken[nPos])=*szDelimiter;
				file.Read(szDelimiter,1);
				nPos++;
			}
			szToken[nPos]='\0';
			nPos=0;
			m_ProductName=szToken;
			GetDlgItem(IDC_PRODUCTNAME)->SetWindowText(m_ProductName);
			file.Read(szDelimiter,1);
STEP1:
			while((*szDelimiter) != '!')
			{
				if((*szDelimiter) == '#')
				{
					m_ConditionInfo="";
					GetDlgItem(IDC_CONDITIONINFO)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO2)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO3)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO4)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO5)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO6)->SetWindowText(m_ConditionInfo);
					file.SeekToBegin();
					goto STEP2;
				}
				(szToken[nPos])=*szDelimiter;
				file.Read(szDelimiter,1);
				nPos++;
			}
			szToken[nPos]='\0';
			nPos=0;
			m_ConditionInfo=szToken;
			//개별로 나눔
			int com1=0, com2=0, com3=0, com4=0, com5=0, com6=0;
			com1=m_ConditionInfo.Find(_T("/"), 0);
			com2=m_ConditionInfo.Find(_T("/"), com1+1);
			com3=m_ConditionInfo.Find(_T("/"), com2+1);
			com4=m_ConditionInfo.Find(_T("/"), com3+1);
			com5=m_ConditionInfo.Find(_T("/"), com4+1);
			com6=m_ConditionInfo.GetLength();
			//20150430 검사값 디스플레이 분리
			GetDlgItem(IDC_CONDITIONINFO)->SetWindowText(m_ConditionInfo.Left(com1));
			GetDlgItem(IDC_CONDITIONINFO2)->SetWindowText(m_ConditionInfo.Left(com2).Mid(com1+1));
			GetDlgItem(IDC_CONDITIONINFO3)->SetWindowText(m_ConditionInfo.Left(com3).Mid(com2+1));
			GetDlgItem(IDC_CONDITIONINFO4)->SetWindowText(m_ConditionInfo.Left(com4).Mid(com3+1));
			GetDlgItem(IDC_CONDITIONINFO5)->SetWindowText(m_ConditionInfo.Left(com5).Mid(com4+1));
			GetDlgItem(IDC_CONDITIONINFO6)->SetWindowText(m_ConditionInfo.Left(com6).Mid(com5+1));

			file.Read(szDelimiter,1);
STEP2:
			while(1)
			{
				while((*szDelimiter) != '.' )
				{
					if((*szDelimiter) == '#' )
						break;
					(szToken[nPos])=*szDelimiter;	
					file.Read(szDelimiter,1);
					nPos++;
				}	
				szToken[nPos]='\0';
				nPos=0;
				tempbad=szToken;	

				file.Read(szDelimiter,1);
				while((*szDelimiter) != '.')
				{
					if((*szDelimiter) == '#' )
						break;
					(szToken[nPos])=*szDelimiter;
					file.Read(szDelimiter,1);
					nPos++;
				}
				szToken[nPos]='\0';
				nPos=0;
				tempx=szToken;

				file.Read(szDelimiter,1);
				while((*szDelimiter) != '+')
				{
					if((*szDelimiter) == '#' )
						break;
					(szToken[nPos])=*szDelimiter;
					file.Read(szDelimiter,1);
					nPos++;
				}
				szToken[nPos]='\0';
				nPos=0;
				tempy=szToken;
				m_BadImg[_wtoi(tempx)][_wtoi(tempy)] = _wtoi(tempbad);
			
				file.Read(szDelimiter,1);
				if((*szDelimiter) == '#' )
					break;
				nPos=0;
			}
		}
		delete [] szToken;
	}
	else
	{
		m_ProductName="";
		GetDlgItem(IDC_PRODUCTNAME)->SetWindowText(m_ProductName);
		m_ConditionInfo="";
		GetDlgItem(IDC_CONDITIONINFO)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO2)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO3)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO4)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO5)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO6)->SetWindowText(m_ConditionInfo);
		return false;
	}

	file.Close();
	return true;
}


void CViewerDlg::GetInfo(void)
{
	if(!b_IsMakeArray)
		return;

	for(int i=0;i<g_Height;i++)
	{
		for(int j=0;j<g_Width;j++)
		{
			m_BadImg[i][j]=0;
		}
	}

	CFile file;
	CString TempPass, m_Data, tempbad, tempx, tempy;
	TempPass.Format(_T("%s\\Log\\%s"), m_StrDirectory, m_StrLogName);
	char szDelimiter[2];
	char *szToken;
	int nPos=0;
	
	if(file.Open(TempPass,CFile::modeRead))
	{
		szToken = new char[file.GetLength()];
		if(file.Read(szDelimiter,1))
		{
			while((*szDelimiter) != '@')
			{
				if((*szDelimiter) == '#')
				{
					m_ProductName="";
					GetDlgItem(IDC_PRODUCTNAME)->SetWindowText(m_ProductName);
					file.SeekToBegin();
					goto STEP1;
				}
				(szToken[nPos])=*szDelimiter;
				file.Read(szDelimiter,1);
				nPos++;
			}
			szToken[nPos]='\0';
			nPos=0;
			m_ProductName=szToken;
			GetDlgItem(IDC_PRODUCTNAME)->SetWindowText(m_ProductName);
			file.Read(szDelimiter,1);
STEP1:
			while((*szDelimiter) != '!')
			{
				if((*szDelimiter) == '#')
				{
					m_ConditionInfo="";
					GetDlgItem(IDC_CONDITIONINFO)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO2)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO3)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO4)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO5)->SetWindowText(m_ConditionInfo);
					GetDlgItem(IDC_CONDITIONINFO6)->SetWindowText(m_ConditionInfo);
					file.SeekToBegin();
					goto STEP2;
				}
				(szToken[nPos])=*szDelimiter;
				file.Read(szDelimiter,1);
				nPos++;
			}
			szToken[nPos]='\0';
			nPos=0;
			m_ConditionInfo=szToken;
			//개별로 나눔
			int com1=0, com2=0, com3=0, com4=0, com5=0, com6=0;
			com1=m_ConditionInfo.Find(_T("/"), 0);
			com2=m_ConditionInfo.Find(_T("/"), com1+1);
			com3=m_ConditionInfo.Find(_T("/"), com2+1);
			com4=m_ConditionInfo.Find(_T("/"), com3+1);
			com5=m_ConditionInfo.Find(_T("/"), com4+1);
			com6=m_ConditionInfo.GetLength();
			//20150430 검사값 디스플레이 분리
			GetDlgItem(IDC_CONDITIONINFO)->SetWindowText(m_ConditionInfo.Left(com1));
			GetDlgItem(IDC_CONDITIONINFO2)->SetWindowText(m_ConditionInfo.Left(com2).Mid(com1+1));
			GetDlgItem(IDC_CONDITIONINFO3)->SetWindowText(m_ConditionInfo.Left(com3).Mid(com2+1));
			GetDlgItem(IDC_CONDITIONINFO4)->SetWindowText(m_ConditionInfo.Left(com4).Mid(com3+1));
			GetDlgItem(IDC_CONDITIONINFO5)->SetWindowText(m_ConditionInfo.Left(com5).Mid(com4+1));
			GetDlgItem(IDC_CONDITIONINFO6)->SetWindowText(m_ConditionInfo.Left(com6).Mid(com5+1));

			file.Read(szDelimiter,1);

		}
STEP2:
		delete [] szToken;
	}
	else
	{
		m_ProductName="";
		GetDlgItem(IDC_PRODUCTNAME)->SetWindowText(m_ProductName);
		m_ConditionInfo="";
		GetDlgItem(IDC_CONDITIONINFO)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO2)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO3)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO4)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO5)->SetWindowText(m_ConditionInfo);
		GetDlgItem(IDC_CONDITIONINFO6)->SetWindowText(m_ConditionInfo);
	}

	file.Close();
}


