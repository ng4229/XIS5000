void CViewerDlg::OnItemchangedFilelist(NMHDR *pNMHDR, LRESULT *pResult)
{
	if(b_AllCheck)
		return;	
	
	LPNMLISTVIEW pNMLV = reinterpret_cast<LPNMLISTVIEW>(pNMHDR);
	
	int num = pNMLV->iItem;	
	if(m_ListNum!=num)
	{
		m_ListNum = num;
		ChangeFile();
		m_ZoomRate=10;
		DrawPicture();
	}
	else
	{
		return;
	}

	*pResult = 0;
}



void CViewerDlg::OnBnClickedCopyreject()  //20170322
{
	CString strSQL;
	CString sHtml;
	int iRead = 0;
	CFile file;

	CString m_FIlename;

	CFile file2;
	CString TempPass, m_Data, tempbad, tempx, tempy;
	TempPass.Format(_T("%s\\Log\\%s"), m_StrDirectory, m_StrLogName);
	char szDelimiter[2];
	int nPos=0;

	m_FIlename=_T("D:\\Database\\daychart2.htm");

	if(m_NameCount==0)
	{				
		//20200601
		if(m_NationalCode==0)
			AfxMessageBox(_T("저장된 영상이 없습니다."));
		else if(m_NationalCode==1)
			AfxMessageBox(_T("There is no saved image."));
		else if(m_NationalCode==2)
			AfxMessageBox(_T("没有保存的图像。"));
		else if(m_NationalCode==3)
			AfxMessageBox(_T("Нет сохраненного изображения."));
		else if(m_NationalCode==4)
			AfxMessageBox(_T("Збереженого зображення немає.。"));
		else if(m_NationalCode==5)
			AfxMessageBox(_T("No hay imagen guardada."));
		else if(m_NationalCode==6)
			AfxMessageBox(_T("Nie ma zapisanego obrazu."));
		else if(m_NationalCode==7)
			AfxMessageBox(_T("沒有儲存的映像檔."));
		return;
	}

	if(m_NationalCode==0)
		m_FIlename=_T("D:\\Database\\daychart2.htm");
	else if(m_NationalCode==1)
		m_FIlename=_T("D:\\Database\\daychart2_eng.htm");
	else if(m_NationalCode==2)
		m_FIlename=_T("D:\\Database\\daychart2_chi.htm");
	else if(m_NationalCode==3)
		m_FIlename=_T("D:\\Database\\daychart2_rus.htm");
	else if(m_NationalCode==4)
		m_FIlename=_T("D:\\Database\\daychart2_ukr.htm");
	else if(m_NationalCode==5)
		m_FIlename=_T("D:\\Database\\daychart2_spn.htm");
	else if(m_NationalCode==6)
		m_FIlename=_T("D:\\Database\\daychart2_pol.htm");
	else if(m_NationalCode==7)
		m_FIlename=_T("D:\\Database\\daychart2_tiw.htm");
	else
		m_FIlename=_T("D:\\Database\\daychart2_eng.htm");

	if(file.Open(m_FIlename, CFile::modeRead))
	{
		DWORD sizeff=file.GetLength();
		char* szToken = new char[sizeff + 1];
		file.Read(szToken, sizeff);
		szToken[sizeff]='\0';
		sHtml = szToken;
		delete szToken;
		file.Close();

		CString pRS1 = _T("");
	
		CString tempRS;
		for(int i=1; i<m_NameCount+1; i++)
		{

			TempPass.Format(_T("%s\\Log\\%s"), m_StrDirectory, m_strNmae[i-1]+ _T(".dat"));

			if(file2.Open(TempPass,CFile::modeRead))
			{
				szToken = new char[file2.GetLength()];
				if(file2.Read(szDelimiter,1))
				{
					while((*szDelimiter) != '@')
					{
						if((*szDelimiter) == '#')
						{
							m_ProductName="";
							file2.SeekToBegin();
						}
						(szToken[nPos])=*szDelimiter;
						file2.Read(szDelimiter,1);
						nPos++;
					}
					szToken[nPos]='\0';
					nPos=0;
					m_ProductName=szToken;

				}
			}
			file2.Close();



			tempRS.Format(_T("<tr height=33 style='mso-height-source:userset;height:24.95pt'><td colspan=4 height=33 class=xl30 style='height:24.95pt'>%s</td><td colspan=3 class=xl30 style='border-left:none'>%d</td><td colspan=6 class=xl30 style='border-left:none'>%s</td></td><td colspan=2 class=xl30 style='border-left:none'></td> </tr>"), m_ProductName,i,m_strNmae[i-1]);
			pRS1 += tempRS;
		}

		CFileDialog filedlg(false, _T("Excel file(*.xls)"), m_CurrentDate, OFN_HIDEREADONLY | OFN_OVERWRITEPROMPT, _T("Save(*.xls) |*.xls|"), NULL);

		

		sHtml.Replace(_T("<--today-->"), m_CurrentDate);
		sHtml.Replace(_T("<--table1-->"), pRS1);
		CString path=_T(""), ext=_T("");


		int user_choice = filedlg.DoModal();
		if (user_choice == IDOK) 
		{
			path = filedlg.GetPathName();
			ext = filedlg.GetFileExt(); 

			if(ext=="xls")
			{
				CFile sFile;
				sFile.Open(path, CFile::modeCreate | CFile::modeWrite);
				DWORD dwSize = sHtml.GetLength();   // 파일의 크기를 바이트 단위로 알아냄 << 첫번째
				char* lpsz = new char[dwSize + 1];
				USES_CONVERSION;
				lpsz=T2A(sHtml);
				int len = strlen(lpsz);
				lpsz[len] = '\0';
				sFile.Write(lpsz, len);
				sHtml.ReleaseBuffer();
				sFile.Close();
			}
		}
	}
}


void CViewerDlg::OnBnClickedUp() //20190611 viewer 개선
{
	// TODO: 여기에 컨트롤 알림 처리기 코드를 추가합니다.
	BYTE vk;
	vk = VK_UP;
	GetDlgItem(IDC_FILELIST)->SetFocus();
	keybd_event(vk,0,0,0);
}


void CViewerDlg::OnBnClickedDown() //20190611 viewer 개선
{
	BYTE vk;
	vk = VK_DOWN;
	GetDlgItem(IDC_FILELIST)->SetFocus();
	keybd_event(vk,0,0,0);
}


