#include "stdafx.h"
#include "Intellisense.h"
#include "ConditionSetup.h"
#include "afxdialogex.h"


// CConditionSetup 대화 상자입니다.

IMPLEMENT_DYNAMIC(CConditionSetup, CDialogEx)

CConditionSetup::CConditionSetup(CWnd* pParent /*=NULL*/)
	: CDialogEx(CConditionSetup::IDD, pParent)
{
	g_OffInspection=false;
	m_RKindCondition=0;
}

CConditionSetup::~CConditionSetup()
{
}

void CConditionSetup::DoDataExchange(CDataExchange* pDX)
{
	CDialogEx::DoDataExchange(pDX);
	DDX_Control(pDX, IDC_BT_SAVE, m_Bt_Save);
	DDX_Control(pDX, IDCANCEL, m_Bt_Close);
	DDX_Radio(pDX, IDC_RKINDCONDITION_0, m_RKindCondition);
	DDX_Control(pDX, IDC_CONDITIONSETUPTAB, m_tabCtrl);
	DDX_Control(pDX, IDC_RKINDCONDITION_0, m_BtKind0);
	DDX_Control(pDX, IDC_RKINDCONDITION_1, m_BtKind1);
	DDX_Control(pDX, IDC_RKINDCONDITION_2, m_BtKind2);
	DDX_Check(pDX, IDC_CHECK1, m_OffInspection);
}


BEGIN_MESSAGE_MAP(CConditionSetup, CDialogEx)
	ON_WM_PAINT()
	ON_WM_CTLCOLOR()
	ON_BN_CLICKED(IDC_RKINDCONDITION_0, &CConditionSetup::OnClickedRkindcondition0)
	ON_COMMAND(IDC_RKINDCONDITION_1, &CConditionSetup::OnRkindcondition1)
	ON_COMMAND(IDC_RKINDCONDITION_2, &CConditionSetup::OnRkindcondition2)
	ON_BN_CLICKED(IDC_BT_SAVE, &CConditionSetup::OnBnClickedBtSave)
	ON_BN_CLICKED(IDC_CHECK1, &CConditionSetup::OnClickedCheck1)
	ON_BN_CLICKED(IDCANCEL, &CConditionSetup::OnBnClickedCancel)
END_MESSAGE_MAP()


// CConditionSetup 메시지 처리기입니다.
BOOL CConditionSetup::OnInitDialog()
{
	CDialogEx::OnInitDialog();

	// TODO:  여기에 추가 초기화 작업을 추가합니다.
	Brush.CreateStockObject(NULL_BRUSH);
	SetWindowPos(NULL, 672, 119, 0, 0, SWP_NOSIZE | SWP_NOZORDER);
	LoadBackground();
	m_Kindtab=0;
	m_tabCtrl.m_Kindtab=m_Kindtab;
	if(m_Kindtab==0)
	{
		m_tabCtrl.InsertItem(0, g_MessageArr[23]);
		m_tabCtrl.InsertItem(1, g_MessageArr[24]);
		m_tabCtrl.InsertItem(2, g_MessageArr[25]);
		m_tabCtrl.InsertItem(3, g_MessageArr[26]);
		m_tabCtrl.InsertItem(4, g_MessageArr[27]);
		m_tabCtrl.InsertItem(5, g_MessageArr[28]);

	}	
	m_tabCtrl.Init();

	//메뉴선택 기능 추가 20171102
	if(g_Masking1==false && g_Masking2 == false)
		GetDlgItem(IDC_RKINDCONDITION_2)->EnableWindow(false); 

	if(g_Special1 == false && g_Special2 == false && g_Special3 == false)
		GetDlgItem(IDC_RKINDCONDITION_1)->EnableWindow(false);
	//메뉴선택 기능 추가 20171102
	

	return TRUE;  // return TRUE unless you set the focus to a control
	// 예외: OCX 속성 페이지는 FALSE를 반환해야 합니다.
}

void CConditionSetup::LoadBackground()
{
	BITMAP bmpInfo;
	if(g_NationalCode==0)
	{
		m_bmpMainBG.LoadBitmap(IDB_BG_CONDITIONSETUP); 
		m_Bt_Close.LoadBitmaps(IDB_SELPRODUCT_EXIT,IDB_SELPRODUCT_EXIT_0); 
		m_Bt_Save.LoadBitmaps(IDB_BTSETUPMENU_SAVE,IDB_BTSETUPMENU_SAVE_1); 
		m_bmpTab0.LoadBitmap(IDB_BTKINDCOND0);
		m_bmpTab0_0.LoadBitmap(IDB_BTKINDCOND0_0);
		m_bmpTab1.LoadBitmap(IDB_BTKINDCOND1);
		m_bmpTab1_0.LoadBitmap(IDB_BTKINDCOND1_0);
		m_bmpTab2.LoadBitmap(IDB_BTKINDCOND2);
		m_bmpTab2_0.LoadBitmap(IDB_BTKINDCOND2_0);
	}
	else if(g_NationalCode==1)
	{
		m_bmpMainBG.LoadBitmap(IDB_BG_CONDITIONSETUP_ENG); 
		m_Bt_Close.LoadBitmaps(IDB_SELPRODUCT_EXIT_ENG,IDB_SELPRODUCT_EXIT_0_ENG); 
		m_Bt_Save.LoadBitmaps(IDB_BTSETUPMENU_SAVE_ENG,IDB_BTSETUPMENU_SAVE_1_ENG); 
		m_bmpTab0.LoadBitmap(IDB_BTKINDCOND0_ENG);
		m_bmpTab0_0.LoadBitmap(IDB_BTKINDCOND0_0_ENG);
		m_bmpTab1.LoadBitmap(IDB_BTKINDCOND1_ENG);
		m_bmpTab1_0.LoadBitmap(IDB_BTKINDCOND1_0_ENG);
		m_bmpTab2.LoadBitmap(IDB_BTKINDCOND2_ENG);
		m_bmpTab2_0.LoadBitmap(IDB_BTKINDCOND2_0_ENG);
	}
	else if(g_NationalCode==2)
	{
		m_bmpMainBG.LoadBitmap(IDB_BG_CONDITIONSETUP_CHI); 
		m_Bt_Close.LoadBitmaps(IDB_SELPRODUCT_EXIT_CHI,IDB_SELPRODUCT_EXIT_0_CHI); 
		m_Bt_Save.LoadBitmaps(IDB_BTSETUPMENU_SAVE_CHI,IDB_BTSETUPMENU_SAVE_1_CHI); 
		m_bmpTab0.LoadBitmap(IDB_BTKINDCOND0_CHI);
		m_bmpTab0_0.LoadBitmap(IDB_BTKINDCOND0_0_CHI);
		m_bmpTab1.LoadBitmap(IDB_BTKINDCOND1_CHI);
		m_bmpTab1_0.LoadBitmap(IDB_BTKINDCOND1_0_CHI);
		m_bmpTab2.LoadBitmap(IDB_BTKINDCOND2_CHI);
		m_bmpTab2_0.LoadBitmap(IDB_BTKINDCOND2_0_CHI);
	}
	else if(g_NationalCode==3)
	{
		m_bmpMainBG.LoadBitmap(IDB_BG_CONDITIONSETUP_SPN); 
		m_Bt_Close.LoadBitmaps(IDB_SELPRODUCT_EXIT_SPN,IDB_SELPRODUCT_EXIT_0_SPN); 
		m_Bt_Save.LoadBitmaps(IDB_BTSETUPMENU_SAVE_SPN,IDB_BTSETUPMENU_SAVE_1_SPN); 
		m_bmpTab0.LoadBitmap(IDB_BTKINDCOND0_SPN);
		m_bmpTab0_0.LoadBitmap(IDB_BTKINDCOND0_0_SPN);
		m_bmpTab1.LoadBitmap(IDB_BTKINDCOND1_SPN);
		m_bmpTab1_0.LoadBitmap(IDB_BTKINDCOND1_0_SPN);
		m_bmpTab2.LoadBitmap(IDB_BTKINDCOND2_SPN);
		m_bmpTab2_0.LoadBitmap(IDB_BTKINDCOND2_0_SPN);
	}

    m_bmpMainBG.GetBitmap(&bmpInfo);
    m_nMainWidth = bmpInfo.bmWidth; 
    m_nMainHeight = bmpInfo.bmHeight; 
	
	m_Bt_Close.SizeToContent();	
	m_Bt_Save.SizeToContent();

	m_BtKind0.SetBitmap(m_bmpTab0);
	m_BtKind1.SetBitmap(m_bmpTab1_0);
	m_BtKind2.SetBitmap(m_bmpTab2_0);
}

BOOL CConditionSetup::PreTranslateMessage(MSG* pMsg)
{
	// TODO: 여기에 특수화된 코드를 추가 및/또는 기본 클래스를 호출합니다.
	if(pMsg->wParam == VK_ESCAPE)
		return FALSE; 
	
	if(pMsg->wParam == VK_RETURN)
		return FALSE;

	return CDialogEx::PreTranslateMessage(pMsg);
}


void CConditionSetup::OnPaint()
{
	CPaintDC dc(this); // device context for painting
	
	CDC MemDC; 
	MemDC.CreateCompatibleDC(&dc);
	MemDC.SelectObject(&m_bmpMainBG);
    dc.BitBlt(0, 0, m_nMainWidth, m_nMainHeight, &MemDC, 0, 0, SRCCOPY);
	MemDC.DeleteDC();
}


HBRUSH CConditionSetup::OnCtlColor(CDC* pDC, CWnd* pWnd, UINT nCtlColor)
{
	HBRUSH hbr = CDialogEx::OnCtlColor(pDC, pWnd, nCtlColor);

	if(nCtlColor == CTLCOLOR_STATIC) 
	{
		pDC->SetTextColor(RGB(255,255,255));  //글씨색 변경	
        pOldBrush = (CBrush*)pDC->SelectObject(&Brush);
        pDC->SetBkMode(TRANSPARENT);
        return (HBRUSH) Brush;
    }
	return hbr;
}

void CConditionSetup::OnClickedRkindcondition0()
{
	// TODO: 여기에 컨트롤 알림 처리기 코드를 추가합니다.
	m_BtKind0.SetBitmap(m_bmpTab0);
	m_BtKind1.SetBitmap(m_bmpTab1_0);
	m_BtKind2.SetBitmap(m_bmpTab2_0);
	m_tabCtrl.DeleteAllItems();
	m_Kindtab=0;
	m_tabCtrl.m_Kindtab=m_Kindtab;
	if(m_Kindtab==0)
	{
		m_tabCtrl.InsertItem(0, g_MessageArr[23]);
		m_tabCtrl.InsertItem(1, g_MessageArr[24]);
		m_tabCtrl.InsertItem(2, g_MessageArr[25]);
		m_tabCtrl.InsertItem(3, g_MessageArr[26]);
		m_tabCtrl.InsertItem(4, g_MessageArr[27]);
		m_tabCtrl.InsertItem(5, g_MessageArr[28]);
	}	
	m_tabCtrl.SetRectangle();
}


void CConditionSetup::OnRkindcondition1()
{
	// TODO: 여기에 명령 처리기 코드를 추가합니다.
	m_BtKind0.SetBitmap(m_bmpTab0_0);
	m_BtKind1.SetBitmap(m_bmpTab1);
	m_BtKind2.SetBitmap(m_bmpTab2_0);
	m_tabCtrl.DeleteAllItems();
	m_Kindtab=1;
	m_tabCtrl.m_Kindtab=m_Kindtab;
	if(m_Kindtab==1)
	{

		if(g_Special1 == true) //메뉴선택 기능 추가 20171102
			m_tabCtrl.InsertItem(0, g_MessageArr[32]);
		//20160428
		if(g_Special2 == true) //메뉴선택 기능 추가 20171102
			m_tabCtrl.InsertItem(1, g_MessageArr[227]);
			
	}
	m_tabCtrl.SetRectangle();
}


void CConditionSetup::OnRkindcondition2()
{
	// TODO: 여기에 명령 처리기 코드를 추가합니다.
	m_BtKind0.SetBitmap(m_bmpTab0_0);
	m_BtKind1.SetBitmap(m_bmpTab1_0);
	m_BtKind2.SetBitmap(m_bmpTab2);
	m_tabCtrl.DeleteAllItems();
	m_Kindtab=2;
	m_tabCtrl.m_Kindtab=m_Kindtab;
	if(m_Kindtab==2)
	{
		if(g_Masking1 == true) //메뉴선택 기능 추가 20171102
			m_tabCtrl.InsertItem(0, g_MessageArr[228]);
		if(g_Masking2 == true) //메뉴선택 기능 추가 20171102
			m_tabCtrl.InsertItem(1, g_MessageArr[229]);
		if(g_Masking3 == true) //메뉴선택 기능 추가 20171102
			m_tabCtrl.InsertItem(2, g_MessageArr[230]);
	}
	m_tabCtrl.SetRectangle();
}


