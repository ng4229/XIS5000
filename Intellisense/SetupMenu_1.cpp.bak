#include "stdafx.h"
#include "Intellisense.h"
#include "SetupMenu_1.h"
#include "afxdialogex.h"


// CSetupMenu_1 대화 상자입니다.
#include "NumPadBack.h"
#include "MessageBoxDlg.h"

#include "MainFrm.h"
